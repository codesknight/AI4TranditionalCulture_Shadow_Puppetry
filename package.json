{
  "name": "shadow-puppetry-demo",
  "version": "0.1.0",
  "private": true,
  "description": "可交互的皮影戏动作展示",
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "prettier --write demo scripts tests package.json .prettierrc.json .github/workflows/verify.yml",
    "format:check": "prettier --check demo scripts tests package.json .prettierrc.json .github/workflows/verify.yml",
    "check": "npm run format:check && node scripts/check.mjs",
    "test": "node --test tests/*.test.cjs",
    "verify": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
